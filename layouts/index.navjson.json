{{- $items := slice -}}
{{- range .Site.Params.menu -}}
  {{- $url := .URL -}}
  {{- if not (hasPrefix $url "http") -}}{{- $url = printf "%s/%s" (strings.TrimSuffix "/" site.BaseURL) (strings.TrimPrefix "/" $url) -}}{{- end -}}
  {{- $items = $items | append (dict "name" .Name "url" $url "external" (hasPrefix .URL "http")) -}}
{{- end -}}
{{- $footer := slice
  (dict "name" "SMS Terms" "url" (absURL "sms-terms/"))
  (dict "name" "SMS Privacy" "url" (absURL "sms-privacy/")) -}}
{{- dict "brand" site.Params.brand "menu" $items "footer" $footer | jsonify (dict "indent" "  ") -}}
